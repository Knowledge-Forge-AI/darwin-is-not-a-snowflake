declared_bash_source_targets() {
  local scope
  local test_dir
  local test_file

  for scope in "$@"; do
    test_dir="$repo_dir/src/test/$scope/bash"
    [ -d "$test_dir" ] || continue
    while IFS= read -r test_file; do
      /usr/bin/awk -f "$test_report_libexec/header-source-targets.awk" "$test_file"
    done < <(find "$test_dir" -type f -name '*.bats' | sort)
  done |
    sed 's/[[:space:]]*$//' |
    /usr/bin/awk -f "$test_report_libexec/nonblank-lines.awk" |
    sort -u
}

write_nix_source_target_details() {
  local all_targets_file="$1"
  local covered_targets_file="$2"
  local details_file="$3"
  local target
  local status

  printf 'target\tstatus\n' > "$details_file"
  while IFS= read -r target; do
    if grep -Fqx "$target" "$covered_targets_file"; then
      status="covered"
    else
      status="missed"
    fi
    printf '%s\t%s\n' "$target" "$status" >> "$details_file"
  done < "$all_targets_file"
}

record_python_source_target_coverage() {
  local metric_scope="$1"
  local python_report_dir
  local declared_targets_file
  local invalid_targets_file
  local details_file
  local covered_count
  local total_count
  local coverage_value
  local target

  shift
  [ "$report" -eq 1 ] || return 0

  python_report_dir="$(report_language_dir "$metric_scope" python)"
  mkdir -p "$python_report_dir"
  declared_targets_file="$python_report_dir/source-targets.declared"
  invalid_targets_file="$python_report_dir/source-targets.invalid"
  details_file="$python_report_dir/source-target-coverage.tsv"

  declared_python_source_targets "$@" > "$declared_targets_file"
  [ -s "$declared_targets_file" ] || return 0

  : > "$invalid_targets_file"
  while IFS= read -r target; do
    [ -f "$repo_dir/$target" ] || printf '%s\n' "$target" >> "$invalid_targets_file"
  done < "$declared_targets_file"

  if [ -s "$invalid_targets_file" ]; then
    printf 'nix-darwin-test: invalid Python source-target declarations for %s:\n' "$metric_scope" >&2
    sed 's/^/  /' "$invalid_targets_file" >&2
    return 1
  fi

  write_nix_source_target_details "$declared_targets_file" "$declared_targets_file" "$details_file"
  covered_count="$(line_count "$declared_targets_file")"
  total_count="$covered_count"
  coverage_value="$(format_coverage_ratio "$covered_count" "$total_count")"
  record_report_metric "$metric_scope" python "source-target coverage" "$coverage_value"
}

record_python_source_target_coverage_for_mode() {
  [ "$report" -eq 1 ] || return 0

  case "$mode" in
    unit)
      record_python_source_target_coverage unit unit
      ;;
    int)
      record_python_source_target_coverage int int
      ;;
    all)
      record_python_source_target_coverage unit unit
      record_python_source_target_coverage int int
      record_python_source_target_coverage all unit int
      ;;
  esac
}

