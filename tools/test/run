record_nix_source_target_coverage() {
  local metric_scope="$1"
  local nix_report_dir
  local all_targets_file
  local declared_targets_file
  local covered_targets_file
  local invalid_targets_file
  local details_file
  local covered_count
  local total_count
  local coverage_value

  shift
  [ "$report" -eq 1 ] || return 0

  nix_report_dir="$(report_language_dir "$metric_scope" nix)"
  mkdir -p "$nix_report_dir"
  all_targets_file="$nix_report_dir/source-targets.all"
  declared_targets_file="$nix_report_dir/source-targets.declared"
  covered_targets_file="$nix_report_dir/source-targets.covered"
  invalid_targets_file="$nix_report_dir/source-targets.invalid"
  details_file="$nix_report_dir/source-target-coverage.tsv"

  discover_nix_source_targets > "$all_targets_file"
  declared_nix_source_targets "$@" > "$declared_targets_file"
  comm -23 "$declared_targets_file" "$all_targets_file" > "$invalid_targets_file"
  if [ -s "$invalid_targets_file" ]; then
    printf 'nix-darwin-test: invalid Nix source-target declarations for %s:\n' "$metric_scope" >&2
    sed 's/^/  /' "$invalid_targets_file" >&2
    return 1
  fi

  comm -12 "$declared_targets_file" "$all_targets_file" > "$covered_targets_file"
  covered_count="$(line_count "$covered_targets_file")"
  total_count="$(line_count "$all_targets_file")"
  coverage_value="$(format_coverage_ratio "$covered_count" "$total_count")"
  record_report_metric "$metric_scope" nix "source-target coverage" "$coverage_value"
  write_nix_source_target_details "$all_targets_file" "$covered_targets_file" "$details_file"
}

record_nix_source_target_coverage_for_mode() {
  [ "$report" -eq 1 ] || return 0

  case "$mode" in
    unit)
      record_nix_source_target_coverage unit unit
      ;;
    int)
      record_nix_source_target_coverage int int
      ;;
    all)
      record_nix_source_target_coverage unit unit
      record_nix_source_target_coverage int int
      record_nix_source_target_coverage all unit int
      ;;
  esac
}

write_statement_coverage_details() {
  local language="$1"
  local all_targets_file="$2"
  local covered_targets_file="$3"
  local details_file="$4"
  local target
  local status
  local total_statements
  local covered_statements

  printf 'target\tstatus\tcovered_statements\ttotal_statements\n' > "$details_file"
  while IFS= read -r target; do
    total_statements="$(statement_line_count "$language" "$repo_dir/$target")"
    if grep -Fqx "$target" "$covered_targets_file"; then
      status="covered"
      covered_statements="$total_statements"
    else
      status="missed"
      covered_statements=0
    fi
    printf '%s\t%s\t%s\t%s\n' "$target" "$status" "$covered_statements" "$total_statements" >> "$details_file"
  done < "$all_targets_file"
}

statement_coverage_counts() {
  local details_file="$1"

  /usr/bin/awk -F '\t' -f "$test_report_libexec/statement-coverage-counts.awk" "$details_file"
}

write_statement_coverage_html() {
  local language="$1"
  local details_file="$2"
  local html_file="$3"

  run_report_python "$repo_dir/libexec/test-report/statement_coverage.py" \
    --language "$language" \
    --details-file "$details_file" \
    --html-file "$html_file"
}

record_bats_statement_coverage() {
  local metric_scope="$1"
  local language="$2"
  local language_report_dir
  local all_targets_file
  local declared_targets_file
  local covered_targets_file
  local invalid_targets_file
  local details_file
  local html_file
  local covered_count
  local total_count
  local counts
  local coverage_value

  shift 2
  [ "$report" -eq 1 ] || return 0
  bats_language_has_tests "$language" "$@" || return 0

  language_report_dir="$(report_language_dir "$metric_scope" "$language")"
  mkdir -p "$language_report_dir"
  all_targets_file="$language_report_dir/statement-targets.all"
  declared_targets_file="$language_report_dir/statement-targets.declared"
  covered_targets_file="$language_report_dir/statement-targets.covered"
  invalid_targets_file="$language_report_dir/statement-targets.invalid"
  details_file="$language_report_dir/statement-coverage.tsv"
  html_file="$language_report_dir/statement-coverage.html"

  discover_bats_language_source_targets "$language" > "$all_targets_file"
  declared_bats_language_source_targets "$language" "$@" > "$declared_targets_file"
  comm -23 "$declared_targets_file" "$all_targets_file" > "$invalid_targets_file"
  if [ -s "$invalid_targets_file" ]; then
    printf 'nix-darwin-test: invalid %s source-target declarations for %s:\n' "$language" "$metric_scope" >&2
    sed 's/^/  /' "$invalid_targets_file" >&2
    return 1
  fi

  comm -12 "$declared_targets_file" "$all_targets_file" > "$covered_targets_file"
  write_statement_coverage_details "$language" "$all_targets_file" "$covered_targets_file" "$details_file"
  write_statement_coverage_html "$language" "$details_file" "$html_file"
  counts="$(statement_coverage_counts "$details_file")"
  covered_count="${counts%%$'\t'*}"
  total_count="${counts##*$'\t'}"
  coverage_value="$(format_coverage_ratio "$covered_count" "$total_count")"
  record_report_metric "$metric_scope" "$language" "statement coverage" "$coverage_value"
}

record_bats_statement_coverage_for_language() {
  local language="$1"

  [ "$report" -eq 1 ] || return 0
  case "$mode" in
    unit)
      record_bats_statement_coverage unit "$language" unit
      ;;
    int)
      record_bats_statement_coverage int "$language" int
      ;;
    all)
      record_bats_statement_coverage unit "$language" unit
      record_bats_statement_coverage int "$language" int
      record_bats_statement_coverage all "$language" unit int
      ;;
  esac
}

record_bats_statement_coverage_for_mode() {
  [ "$report" -eq 1 ] || return 0

  record_bats_statement_coverage_for_language awk
  record_bats_statement_coverage_for_language applescript
}

discover_zsh_source_targets() {
  find "$repo_dir/bin" "$repo_dir/tools" "$repo_dir/libexec" -type f 2>/dev/null |
    while IFS= read -r file; do
      LC_ALL=C grep -Iq . "$file" || continue
      case "$(sed -n '1p' "$file" 2>/dev/null || true)" in
        *zsh*)
          printf '%s\n' "$file"
          ;;
      esac
    done |
    /usr/bin/awk -v prefix="$repo_dir/" -f "$test_report_libexec/relative-paths.awk" |
    sort -u
}

zsh_has_tests() {
  local scope
  local test_dir

  for scope in "$@"; do
    test_dir="$repo_dir/src/test/$scope/zsh"
    [ -d "$test_dir" ] || continue
    if find "$test_dir" -type f -name '*.zunit' -print -quit | grep -q .; then
      return 0
    fi
  done

  return 1
}

declared_zsh_source_targets() {
  local scope
  local test_dir
  local test_file

  for scope in "$@"; do
    test_dir="$repo_dir/src/test/$scope/zsh"
    [ -d "$test_dir" ] || continue
    while IFS= read -r test_file; do
      /usr/bin/awk -f "$test_report_libexec/header-source-targets.awk" "$test_file"
    done < <(find "$test_dir" -type f -name '*.zunit' | sort)
  done |
    sed 's/[[:space:]]*$//' |
    /usr/bin/awk -f "$test_report_libexec/nonblank-lines.awk" |
    sort -u
}

record_zsh_statement_coverage() {
  local metric_scope="$1"
  local zsh_report_dir
  local all_targets_file
  local declared_targets_file
  local covered_targets_file
  local invalid_targets_file
  local details_file
  local html_file
