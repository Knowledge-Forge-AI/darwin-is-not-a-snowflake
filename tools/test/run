  local scope
  local test_dir
  local test_file

  for scope in "$@"; do
    test_dir="$repo_dir/src/test/$scope/python"
    [ -d "$test_dir" ] || continue
    while IFS= read -r test_file; do
      /usr/bin/awk -f "$test_report_libexec/header-source-targets.awk" "$test_file"
    done < <(find "$test_dir" -type f -name '*.test.py' | sort)
  done |
    sed 's/[[:space:]]*$//' |
    /usr/bin/awk -f "$test_report_libexec/nonblank-lines.awk" |
    sort -u
}

