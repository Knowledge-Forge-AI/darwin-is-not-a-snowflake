prepare_bash_kcov_environment() {
  local scope="$1"
  local kcov_root
  local source_files
  local include_patterns
  local parse_dirs
  local real_bash
  local wrapper_dir

  [ "$report" -eq 1 ] || return 1
  command -v kcov >/dev/null 2>&1 || return 1
  [ -x "$kcov_bash_wrapper" ] || return 1

  real_bash="$(command -v bash)"
  [ -x "$real_bash" ] || return 1

  kcov_root="$(report_language_dir "$scope" bash)"
  source_files="$kcov_root/kcov-source-files.txt"
  mkdir -p "$kcov_root"
  discover_bash_source_files > "$source_files"
  [ -s "$source_files" ] || return 1

  include_patterns="$(join_lines_by_comma < "$source_files")"
  parse_dirs="$(parent_dirs_from_files < "$source_files" | join_lines_by_comma)"
  wrapper_dir="$kcov_root/kcov-wrapper"
  mkdir -p "$wrapper_dir" "$kcov_root/kcov-runs"
  {
    printf '#!%s\n' "$real_bash"
    sed '1d' "$kcov_bash_wrapper"
  } > "$wrapper_dir/bash"
  chmod +x "$wrapper_dir/bash"

  NIX_DARWIN_KCOV_PATH="$wrapper_dir:$PATH"
  NIX_DARWIN_KCOV_RUN_DIR="$kcov_root/kcov-runs"
  NIX_DARWIN_KCOV_PARSE_DIRS="$parse_dirs"
  NIX_DARWIN_KCOV_INCLUDE_PATTERNS="$include_patterns"
  NIX_DARWIN_KCOV_EXCLUDE_PATHS="$repo_dir/src/test,$repo_dir/.test-reports,$repo_dir/tools/test"
  NIX_DARWIN_KCOV_REAL_BASH="$real_bash"
  NIX_DARWIN_KCOV_STDERR_FILTER="$test_report_libexec/kcov-stderr-filter.awk"
  return 0
}

run_bats_with_optional_bash_kcov() {
  local scope="$1"
  local language="$2"
  local test_file=""
  shift 2
  for test_file in "$@"; do
    :
  done

  if [ "$language" = bash ] && [ "$(basename "$test_file")" != "test-runner.int.test.bats" ] && prepare_bash_kcov_environment "$scope"; then
    NIX_DARWIN_TEST_ROOT="$repo_dir" \
      NIX_DARWIN_TEST_REPORT_ROOT="$report_dir" \
      NIX_DARWIN_KCOV_REAL_BASH="$NIX_DARWIN_KCOV_REAL_BASH" \
      NIX_DARWIN_KCOV_RUN_DIR="$NIX_DARWIN_KCOV_RUN_DIR" \
      NIX_DARWIN_KCOV_PARSE_DIRS="$NIX_DARWIN_KCOV_PARSE_DIRS" \
      NIX_DARWIN_KCOV_INCLUDE_PATTERNS="$NIX_DARWIN_KCOV_INCLUDE_PATTERNS" \
      NIX_DARWIN_KCOV_EXCLUDE_PATHS="$NIX_DARWIN_KCOV_EXCLUDE_PATHS" \
      NIX_DARWIN_KCOV_STDERR_FILTER="$NIX_DARWIN_KCOV_STDERR_FILTER" \
      PATH="$NIX_DARWIN_KCOV_PATH" \
      run_bats "$@"
    return
  fi

  run_bats "$@"
}

record_bash_kcov_coverage() {
  local metric_scope="$1"
  local kcov_root
  local runs_dir
  local output_dir
  local coverage_json
  local coverage_percent

  [ "$report" -eq 1 ] || return 0
  command -v kcov >/dev/null 2>&1 || return 0

  kcov_root="$(report_language_dir "$metric_scope" bash)"
  runs_dir="$kcov_root/kcov-runs"
  [ -d "$runs_dir" ] || return 0
  find "$runs_dir" -mindepth 1 -maxdepth 1 -type d -print -quit | grep -q . || return 0

  output_dir="$kcov_root/kcov"
  rm -rf "$output_dir"
  kcov --merge "$output_dir" "$runs_dir"/*
  coverage_json="$output_dir/kcov-merged/coverage.json"
  [ -f "$coverage_json" ] || return 0

  coverage_percent="$(coverage_percent_from_json "$coverage_json")"
  record_report_metric "$metric_scope" bash "statement coverage" "$coverage_percent"
}

record_bash_kcov_coverage_for_mode() {
  [ "$report" -eq 1 ] || return 0

  case "$mode" in
    unit)
      record_bash_kcov_coverage unit
      ;;
    int)
      record_bash_kcov_coverage int
      ;;
    all)
      record_bash_kcov_coverage unit
      record_bash_kcov_coverage int
      merge_bash_kcov_coverage all unit int
      ;;
  esac
}

merge_bash_kcov_coverage() {
  local metric_scope="$1"
  local kcov_root
  local output_dir
  local coverage_json
  local coverage_percent
  local merge_inputs=()
  local source_scope
  local source_dir

  shift
  [ "$report" -eq 1 ] || return 0
  command -v kcov >/dev/null 2>&1 || return 0

  for source_scope in "$@"; do
    source_dir="$(report_language_dir "$source_scope" bash)/kcov"
    [ -d "$source_dir" ] || continue
    merge_inputs+=("$source_dir")
  done

  [ "${#merge_inputs[@]}" -gt 0 ] || return 0
  kcov_root="$(report_language_dir "$metric_scope" bash)"
  output_dir="$kcov_root/kcov"
  mkdir -p "$kcov_root"
  rm -rf "$output_dir"
  kcov --merge "$output_dir" "${merge_inputs[@]}"
  coverage_json="$output_dir/kcov-merged/coverage.json"
  [ -f "$coverage_json" ] || return 0

  coverage_percent="$(coverage_percent_from_json "$coverage_json")"
  record_report_metric "$metric_scope" bash "statement coverage" "$coverage_percent"
}

print_report_summary() {
  local scope
  local language
  local metric
  local value

  [ "$report" -eq 1 ] || return 0

  printf '\nTest Report Summary\n'
  if [ -f "$summary_file" ]; then
    while IFS=$'\t' read -r scope language metric value; do
      [ "$scope" != "scope" ] || continue
      [ -n "$scope" ] || continue
      printf '%s %s %s: %s\n' "$(scope_label "$scope")" "$language" "$metric" "$value"
    done < "$summary_file"
  fi
  printf 'Detailed reports: %s\n' "$report_dir"
}

coverage_gate_failure_count() {
  local scope
  local language
  local metric
  local value
  local total=0

  [ "$report" -eq 1 ] || {
    printf '0\n'
    return 0
  }
  [ -f "$summary_file" ] || {
    printf '0\n'
    return 0
  }

  while IFS=$'\t' read -r scope language metric value; do
    [ "$scope" != "scope" ] || continue
    [ "$metric" = "coverage.gate.failures" ] || continue
    case "$value" in
      ''|*[!0-9]*)
        continue
        ;;
    esac
    total=$((total + value))
  done < "$summary_file"
  printf '%s\n' "$total"
}

confirm_coverage_gate_override() {
  local failure_count="$1"
  local response

  printf '\n!!! EMERGENCY COVERAGE GATE OVERRIDE REQUESTED !!!\n' >&2
  printf 'Coverage gates failed with %s failure(s).\n' "$failure_count" >&2
  printf 'Hard-gate details:\n' >&2
  while IFS=$'\t' read -r scope language metric value; do
    case "$metric:$value" in
      coverage.gate.hard.*:fail\ *)
        printf '  %s %s %s: %s\n' "$(scope_label "$scope")" "$language" "$metric" "$value" >&2
        ;;
    esac
  done < "$summary_file"
  printf 'Report root: %s\n' "$report_dir" >&2
  printf 'Final HTML will be rendered after this decision.\n' >&2
  printf 'Use this only for exceptional maintenance, not normal updates.\n' >&2
  printf 'Type yes to continue despite failed coverage gates: ' >&2
  IFS= read -r response || response=""

  case "$response" in
    [Yy][Ee][Ss])
      record_report_metric "$mode" coverage "coverage.gate.override" "used"
      printf 'nix-darwin-test: coverage gate override confirmed; continuing despite failed gates.\n' >&2
      return 0
      ;;
    *)
      printf 'nix-darwin-test: coverage gate override declined; exiting.\n' >&2
      return 1
      ;;
  esac
}

enforce_coverage_gates() {
  local failure_count

  [ "$report" -eq 1 ] || return 0
  failure_count="$(coverage_gate_failure_count)"
  [ "$failure_count" -gt 0 ] || return 0

  if [ "${NIX_DARWIN_SKIP_COVERAGE_GATES:-}" = "1" ]; then
    confirm_coverage_gate_override "$failure_count"
    return
  fi

  printf '\nnix-darwin-test: coverage gates failed (%s failure(s)).\n' "$failure_count" >&2
  printf 'Set NIX_DARWIN_SKIP_COVERAGE_GATES=1 for the emergency override path.\n' >&2
  return 1
}

if [ "$#" -gt 0 ]; then
  case "$1" in
    all|unit|int)
      mode="$1"
      shift
      ;;
  esac
fi

while [ "$#" -gt 0 ]; do
  case "$1" in
    --full)
      full=1
      ;;
    --report)
      report=1
      ;;
    --report-root)
      shift
      [ "$#" -gt 0 ] || fail "--report-root requires an absolute path"
      case "$1" in
        /*) report_root="$1" ;;
        *) fail "--report-root requires an absolute path" ;;
      esac
      ;;
    -j)
      shift
      [ "$#" -gt 0 ] || fail "-j requires a positive integer"
      jobs="$1"
      ;;
    --jobs)
      shift
      [ "$#" -gt 0 ] || fail "--jobs requires a positive integer"
      jobs="$1"
      ;;
    --flake-option)
      shift
      [ "$#" -gt 0 ] || fail "--flake-option requires a value"
      flake_options+=("$1")
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      fail "unknown option: $1"
      ;;
  esac
  shift
done

validate_jobs
validate_build_jobs
[ -d "$repo_dir" ] || fail "repo root does not exist: $repo_dir"
prepare_report

run_shell_syntax_checks() {
  local shell_dir="$repo_dir/shell"
  local scripts_dir="$repo_dir/scripts"
  local file
  local check_status
  local syntax_status=0

  if [ -d "$scripts_dir" ]; then
    while IFS= read -r file; do
      if bash -n "$file"; then
        :
      else
        check_status="$?"
        [ "$report" -eq 1 ] || return "$check_status"
        [ "$syntax_status" -ne 0 ] || syntax_status="$check_status"
      fi
    done < <(find "$scripts_dir" -maxdepth 1 -type f -name '*.sh' | sort)
  fi

  for file in "$shell_dir/bash_profile" "$shell_dir/bashrc"; do
    [ -f "$file" ] || continue
    if bash -n "$file"; then
      :
    else
      check_status="$?"
      [ "$report" -eq 1 ] || return "$check_status"
      [ "$syntax_status" -ne 0 ] || syntax_status="$check_status"
    fi
  done

  for fragment_dir in "$shell_dir/sh_config/bash" "$shell_dir/sh_config/common"; do
    [ -d "$fragment_dir" ] || continue
    while IFS= read -r file; do
      if bash -n "$file"; then
        :
      else
        check_status="$?"
        [ "$report" -eq 1 ] || return "$check_status"
        [ "$syntax_status" -ne 0 ] || syntax_status="$check_status"
      fi
    done < <(find "$fragment_dir" -maxdepth 1 -type f | sort)
  done

  if [ -f "$shell_dir/zshrc" ]; then
    if zsh -n "$shell_dir/zshrc"; then
      :
    else
      check_status="$?"
      [ "$report" -eq 1 ] || return "$check_status"
      [ "$syntax_status" -ne 0 ] || syntax_status="$check_status"
    fi
  fi

  if [ -d "$repo_dir/tools/bootstrap" ]; then
    while IFS= read -r file; do
      case "$(sed -n '1p' "$file" 2>/dev/null || true)" in
        *zsh*)
          if zsh -n "$file"; then
            :
          else
            check_status="$?"
            [ "$report" -eq 1 ] || return "$check_status"
            [ "$syntax_status" -ne 0 ] || syntax_status="$check_status"
          fi
          ;;
      esac
    done < <(find "$repo_dir/tools/bootstrap" -maxdepth 1 -type f | sort)
  fi

  for zsh_source_root in "$repo_dir/bin" "$repo_dir/libexec" "$repo_dir/tools"; do
    [ -d "$zsh_source_root" ] || continue
    while IFS= read -r file; do
      case "$file" in
        *.pyc) continue ;;
      esac
      LC_ALL=C grep -Iq . "$file" || continue
      case "$(sed -n '1p' "$file" 2>/dev/null || true)" in
        *zsh*)
          if zsh -n "$file"; then
            :
          else
            check_status="$?"
            [ "$report" -eq 1 ] || return "$check_status"
            [ "$syntax_status" -ne 0 ] || syntax_status="$check_status"
          fi
          ;;
      esac
    done < <(find "$zsh_source_root" -type f | sort)
  done

  if [ -d "$shell_dir/oh-my-zsh-custom/themes" ]; then
    while IFS= read -r file; do
      if zsh -n "$file"; then
        :
      else
        check_status="$?"
        [ "$report" -eq 1 ] || return "$check_status"
        [ "$syntax_status" -ne 0 ] || syntax_status="$check_status"
      fi
    done < <(find "$shell_dir/oh-my-zsh-custom/themes" -maxdepth 1 -type f -name '*.zsh-theme' | sort)
  fi

  for fragment_dir in "$shell_dir/sh_config/zsh" "$shell_dir/sh_config/common"; do
    [ -d "$fragment_dir" ] || continue
    while IFS= read -r file; do
      if zsh -n "$file"; then
        :
      else
        check_status="$?"
        [ "$report" -eq 1 ] || return "$check_status"
        [ "$syntax_status" -ne 0 ] || syntax_status="$check_status"
      fi
    done < <(find "$fragment_dir" -maxdepth 1 -type f | sort)
  done

  return "$syntax_status"
}

run_bats_lane() {
  local scope="$1"
  local language="$2"
  local test_dir="$repo_dir/src/test/$scope/$language"
  local bats_report_dir
  local test_file
  local bats_steps=()

  [ -d "$test_dir" ] || return 0

  while IFS= read -r test_file; do
    if [ "$report" -eq 1 ]; then
      bats_report_dir="$(report_language_dir "$scope" "$language")/$(basename "$test_file")"
      mkdir -p "$bats_report_dir"
      run_step "$scope/$language/$(basename "$test_file")" run_bats_report "$scope" "$language" "$bats_report_dir" "$test_file"
    else
      bats_steps+=("$scope/$language/$(basename "$test_file")" run_bats "$test_file" ":::")
    fi
  done < <(find "$test_dir" -type f -name '*.bats' | sort)

  if [ "$report" -eq 0 ] && [ "${#bats_steps[@]}" -gt 0 ]; then
    run_parallel_steps "$jobs" "${bats_steps[@]}"
  fi
  return 0
}

run_bats_report() {
  local scope="$1"
  local language="$2"
  local output_dir="$3"
  local test_outputs_dir="$output_dir/test-outputs"
  shift 3

  rm -rf "$test_outputs_dir"
  mkdir -p "$test_outputs_dir"
  run_report_command "$output_dir/output.txt" \
    run_bats_with_optional_bash_kcov "$scope" "$language" \
      --report-formatter junit \
      --output "$output_dir" \
      --gather-test-outputs-in "$test_outputs_dir" \
      --show-output-of-passing-tests \
      --verbose-run \
      --print-output-on-failure \
      "$@"
}

run_bats() {
  if command -v bats >/dev/null 2>&1; then
    bats "$@" < /dev/null
    return
  fi

  local system="${NIX_DARWIN_TEST_SYSTEM:-aarch64-darwin}"
  nix shell "$flake_ref#legacyPackages.$system.bats" -c bats "$@" < /dev/null
}

run_pytest() {
  local python_pycache_prefix="$1"
  local python_import_check='import pytest'
  shift

  if [ "$report" -eq 1 ]; then
    python_import_check='import pytest, pytest_cov, pytest_jsonreport'
  elif parallel_enabled; then
    python_import_check='import pytest, xdist'
  fi

  if command -v pytest >/dev/null 2>&1 &&
    command -v python3 >/dev/null 2>&1 &&
    python3 -c "$python_import_check" >/dev/null 2>&1; then
    env PYTHONPYCACHEPREFIX="$python_pycache_prefix" pytest "$@"
    return
  fi

  local system="${NIX_DARWIN_TEST_SYSTEM:-aarch64-darwin}"
  env PYTHONPYCACHEPREFIX="$python_pycache_prefix" \
    nix shell "$flake_ref#nixDarwinTestPython" -c pytest "$@"
}

run_python_lane() {
  local scope="$1"
  local test_dir="$repo_dir/src/test/$scope/python"
  local python_report_dir
  local python_coverage_xml
  local python_metric_file
  local python_branch_coverage
  local python_statement_coverage
  local pytest_args

  [ -d "$test_dir" ] || return 0
  find "$test_dir" -type f -name '*.test.py' -print -quit | grep -q . || return 0

  mkdir -p "$python_pycache_prefix"
  pytest_args=()

  if [ "$report" -eq 0 ] && parallel_enabled; then
    pytest_args+=("-n" "$jobs")
  fi

  pytest_args+=("$test_dir")

  if [ "$report" -eq 1 ]; then
    python_report_dir="$(report_language_dir "$scope" python)"
    python_coverage_xml="$python_report_dir/coverage.xml"
    mkdir -p "$python_report_dir"
    pytest_args+=(
      "--junitxml=$python_report_dir/junit.xml"
      "--json-report"
      "--json-report-file=$python_report_dir/report.json"
      "-o"
      "junit_logging=all"
      "-o"
      "junit_log_passing_tests=true"
      "--tb=long"
    )
    if [ "$scope" = unit ]; then
      pytest_args+=(
        "--cov=$repo_dir/libexec"
        "--cov=$repo_dir/tools/test/report"
        "--cov-branch"
        "--cov-report=term-missing"
        "--cov-report=xml:$python_coverage_xml"
        "--cov-report=html:$python_report_dir/html"
      )
    fi
  fi

  if [ "$report" -eq 1 ]; then
    run_step "$scope/python/pytest" run_report_command "$python_report_dir/output.txt" \
      run_pytest "$python_pycache_prefix" "${pytest_args[@]}"
  else
    run_step "$scope/python/pytest" run_pytest "$python_pycache_prefix" "${pytest_args[@]}"
  fi

  if [ "$report" -eq 1 ] && [ -f "$python_coverage_xml" ]; then
    python_metric_file="$(report_metric_file "$scope" python)"
    python_statement_coverage="$(coverage_percent_from_xml "$python_coverage_xml" line-rate)"
    record_report_metric_to_file "$python_metric_file" "$scope" python "statement coverage" "$python_statement_coverage"
    if python_branch_coverage="$(coverage_percent_from_xml "$python_coverage_xml" branch-rate)"; then
      record_report_metric_to_file "$python_metric_file" "$scope" python "branch coverage" "$python_branch_coverage"
    fi
  fi
}

run_zsh_lane() {
  local scope="$1"
  local test_dir="$repo_dir/src/test/$scope/zsh"
  local zsh_report_dir
  local test_file
  local zsh_steps=()

  [ -d "$test_dir" ] || return 0

  while IFS= read -r test_file; do
    if [ "$report" -eq 1 ]; then
      zsh_report_dir="$(report_language_dir "$scope" zsh)/$(basename "$test_file")"
      mkdir -p "$zsh_report_dir"
      run_step "$scope/zsh/$(basename "$test_file")" run_zunit_report "$zsh_report_dir/output.tap" "$test_file"
    else
      zsh_steps+=("$scope/zsh/$(basename "$test_file")" run_zunit "$test_file" ":::")
    fi
  done < <(find "$test_dir" -type f -name '*.zunit' | sort)

  if [ "$report" -eq 0 ] && [ "${#zsh_steps[@]}" -gt 0 ]; then
    run_parallel_steps "$jobs" "${zsh_steps[@]}"
  fi
}

run_zunit() {
  if command -v zunit >/dev/null 2>&1; then
    zunit --tap "$@"
    return
  fi

  local system="${NIX_DARWIN_TEST_SYSTEM:-aarch64-darwin}"
  nix shell "$flake_ref#legacyPackages.$system.zunit" -c zunit --tap "$@"
}

run_zunit_verbose() {
  if command -v zunit >/dev/null 2>&1; then
    zunit --tap --verbose "$@"
    return
  fi

  local system="${NIX_DARWIN_TEST_SYSTEM:-aarch64-darwin}"
  nix shell "$flake_ref#legacyPackages.$system.zunit" -c zunit --tap --verbose "$@"
}

run_zunit_report() {
  local output_file="$1"

  shift
  run_report_command "$output_file" run_zunit_verbose "$@"
}

run_ruby_lane() {
  local scope="$1"
  local test_dir="$repo_dir/src/test/$scope/ruby"
  local test_file
  local test_files=()
  local ruby_steps=()
  local ruby_report_dir
  local ruby_result_json
  local ruby_metric_file
  local simplecov_prelude="$script_dir/ruby/simplecov-prelude.rb"
  local ruby_branch_coverage
  local ruby_statement_coverage

  [ -d "$test_dir" ] || return 0

  while IFS= read -r test_file; do
    test_files+=("$test_file")
  done < <(find "$test_dir" -type f -name '*.rb' | sort)

  [ "${#test_files[@]}" -gt 0 ] || return 0

  if [ "$report" -eq 1 ]; then
    ruby_report_dir="$(report_language_dir "$scope" ruby)"
    ruby_result_json="$ruby_report_dir/results.json"
    mkdir -p "$ruby_report_dir"
    if [ "$scope" = unit ]; then
      run_step "$scope/ruby/minitest" run_report_command "$ruby_report_dir/output.txt" \
        run_ruby_with_coverage "$ruby_report_dir" "$ruby_result_json" "$simplecov_prelude" "$script_dir/ruby/minitest-runner.rb" --verbose "${test_files[@]}"
    else
      run_step "$scope/ruby/minitest" run_report_command "$ruby_report_dir/output.txt" \
        run_ruby_with_results "$ruby_result_json" "$script_dir/ruby/minitest-runner.rb" --verbose "${test_files[@]}"
    fi
  else
    for test_file in "${test_files[@]}"; do
      ruby_steps+=("$scope/ruby/$(basename "$test_file")" ruby "$test_file" ":::")
    done
    run_parallel_steps "$jobs" "${ruby_steps[@]}"
  fi

  if [ "$report" -eq 1 ] && [ -f "$ruby_report_dir/.last_run.json" ]; then
    ruby_metric_file="$(report_metric_file "$scope" ruby)"
    ruby_statement_coverage="$(ruby_coverage_percent "$ruby_report_dir/.last_run.json" line)"
    record_report_metric_to_file "$ruby_metric_file" "$scope" ruby "statement coverage" "$ruby_statement_coverage"
    if ruby_branch_coverage="$(ruby_coverage_percent "$ruby_report_dir/.last_run.json" branch)"; then
      record_report_metric_to_file "$ruby_metric_file" "$scope" ruby "branch coverage" "$ruby_branch_coverage"
    fi
  fi
}

run_ruby_with_results() {
  local ruby_result_json="$1"
  shift

  if command -v ruby >/dev/null 2>&1; then
    env \
      NIX_DARWIN_TEST_RESULT_JSON="$ruby_result_json" \
      NIX_DARWIN_TEST_ROOT="$repo_dir" \
      ruby "$@"
    return
  fi

  local system="${NIX_DARWIN_TEST_SYSTEM:-aarch64-darwin}"
  env \
    NIX_DARWIN_TEST_RESULT_JSON="$ruby_result_json" \
    NIX_DARWIN_TEST_ROOT="$repo_dir" \
    nix shell "$flake_ref#nixDarwinTestRuby" -c ruby "$@"
}

run_ruby_with_coverage() {
  local ruby_report_dir="$1"
  local ruby_result_json="$2"
  local simplecov_prelude="$3"
  shift 3

  if command -v ruby >/dev/null 2>&1 && ruby -rsimplecov -e 'exit 0' >/dev/null 2>&1; then
    env \
      NIX_DARWIN_TEST_COVERAGE_DIR="$ruby_report_dir" \
      NIX_DARWIN_TEST_RESULT_JSON="$ruby_result_json" \
      NIX_DARWIN_TEST_ROOT="$repo_dir" \
      ruby -r "$simplecov_prelude" "$@"
    return
  fi

  local system="${NIX_DARWIN_TEST_SYSTEM:-aarch64-darwin}"
  env \
    NIX_DARWIN_TEST_COVERAGE_DIR="$ruby_report_dir" \
    NIX_DARWIN_TEST_RESULT_JSON="$ruby_result_json" \
    NIX_DARWIN_TEST_ROOT="$repo_dir" \
    nix shell "$flake_ref#nixDarwinTestRuby" -c ruby -r "$simplecov_prelude" "$@"
}

run_applescript_lane() {
  local scope="$1"
  local test_dir="$repo_dir/src/test/$scope/applescript"
  local test_file
  local applescript_steps=()

  [ -d "$test_dir" ] || return 0

  while IFS= read -r test_file; do
    if [ "$report" -eq 0 ]; then
      applescript_steps+=("$scope/applescript/$(basename "$test_file")" run_applescript_compile "$test_file" ":::")
    else
      run_step "$scope/applescript/$(basename "$test_file")" run_applescript_compile "$test_file"
    fi
  done < <(find "$test_dir" -type f -name '*.applescript' | sort)

  if [ "$report" -eq 0 ] && [ "${#applescript_steps[@]}" -gt 0 ]; then
    run_parallel_steps "$jobs" "${applescript_steps[@]}"
  fi
}

run_applescript_compile() {
  local test_file="$1"
  local output_file
  local status

  output_file="$(mktemp "${TMPDIR:-/tmp}/nix-darwin-applescript-test.XXXXXX")" \
    || fail "could not create AppleScript compile output path"
  if osacompile -o "$output_file" "$test_file"; then
    status=0
  else
    status="$?"
  fi
  rm -f "$output_file"
  return "$status"
}

run_nix_unit() (
  local system="${NIX_DARWIN_TEST_SYSTEM:-aarch64-darwin}"
  local nix_unit_runtime_dir

  nix_unit_runtime_dir="$(mktemp -d "${TMPDIR:-/tmp}/nix-darwin-nix-unit.XXXXXX")" \
    || fail "could not create nix-unit runtime directory"
  trap 'rm -rf "$nix_unit_runtime_dir"' EXIT
  mkdir -p "$nix_unit_runtime_dir/conf" "$nix_unit_runtime_dir/gc-roots"
  export NIX_CONF_DIR="$nix_unit_runtime_dir/conf"
  export NIX_CONFIG="experimental-features = nix-command flakes"

  if command -v nix-unit >/dev/null 2>&1; then
    nix-unit \
      --gc-roots-dir "$nix_unit_runtime_dir/gc-roots" \
      --arg repoRoot "$repo_dir" \
      --argstr system "$system" \
      "$@"
    return
  fi

  nix shell "$flake_ref#legacyPackages.$system.nix-unit" -c nix-unit \
    --gc-roots-dir "$nix_unit_runtime_dir/gc-roots" \
    --arg repoRoot "$repo_dir" \
    --argstr system "$system" \
    "$@"
)

run_nix_lane() {
  local scope="$1"
  local test_dir="$repo_dir/src/test/$scope/nix"
  local nix_report_dir
  local test_file
  local nix_steps=()

  [ -d "$test_dir" ] || return 0
  find "$test_dir" -type f -name '*.nix' -print -quit | grep -q . || return 0

  while IFS= read -r test_file; do
    if [ "$report" -eq 1 ]; then
      nix_report_dir="$(report_language_dir "$scope" nix)/$(basename "$test_file")"
      mkdir -p "$nix_report_dir"
      run_step "$scope/nix/$(basename "$test_file")" run_nix_unit_report "$nix_report_dir/output.txt" "$test_file"
    else
      nix_steps+=("$scope/nix/$(basename "$test_file")" run_nix_unit "$test_file" ":::")
    fi
  done < <(find "$test_dir" -type f -name '*.nix' | sort)

  if [ "$report" -eq 0 ] && [ "${#nix_steps[@]}" -gt 0 ]; then
    run_parallel_steps "$jobs" "${nix_steps[@]}"
  fi
}

run_nix_unit_report() {
  local output_file="$1"

  shift
  run_report_command "$output_file" run_nix_unit "$@"
}

run_language_lanes() {
  local scope="$1"

  run_bats_lane "$scope" bash
  run_bats_lane "$scope" awk
  run_bats_lane "$scope" applescript
  run_python_lane "$scope"
  run_zsh_lane "$scope"
  run_ruby_lane "$scope"
  run_applescript_lane "$scope"
  run_nix_lane "$scope"
}

run_language_lanes_parallel() {
  local scope="$1"

  run_parallel_steps "$jobs" \
    "$scope/bash" run_bats_lane "$scope" bash ::: \
    "$scope/awk" run_bats_lane "$scope" awk ::: \
    "$scope/applescript/bats" run_bats_lane "$scope" applescript ::: \
    "$scope/python/pytest" run_python_lane "$scope" ::: \
    "$scope/zsh" run_zsh_lane "$scope" ::: \
    "$scope/ruby" run_ruby_lane "$scope" ::: \
    "$scope/applescript/osacompile" run_applescript_lane "$scope" ::: \
    "$scope/nix" run_nix_lane "$scope" :::
}

run_report_lane_for_parallel() {
  current_report_lane_status=0
  "$@"
  return "$current_report_lane_status"
}

run_report_lane_serial() {
  local label="$1"
  local status=0

  shift
  current_report_lane_status=0
  if "$@"; then
    status="$current_report_lane_status"
  else
    status="$?"
    [ "$current_report_lane_status" -ne 0 ] || current_report_lane_status="$status"
  fi
  status="$current_report_lane_status"
  if [ "$status" -ne 0 ]; then
    record_execution_failure "$label" "$status"
    if [ "$suite_status" -eq 0 ]; then
      suite_status="$status"
    fi
  fi
}

run_report_language_lanes_serial() {
  local scope="$1"

  run_report_lane_serial "$scope/bash" run_bats_lane "$scope" bash
  run_report_lane_serial "$scope/awk" run_bats_lane "$scope" awk
  run_report_lane_serial "$scope/applescript/bats" run_bats_lane "$scope" applescript
  run_report_lane_serial "$scope/python/pytest" run_python_lane "$scope"
  run_report_lane_serial "$scope/zsh" run_zsh_lane "$scope"
  run_report_lane_serial "$scope/ruby" run_ruby_lane "$scope"
  run_report_lane_serial "$scope/applescript/osacompile" run_applescript_lane "$scope"
  run_report_lane_serial "$scope/nix" run_nix_lane "$scope"
}

run_report_language_lanes_parallel() {
  local scope="$1"

  run_parallel_steps "$jobs" \
    "$scope/bash" run_report_lane_for_parallel run_bats_lane "$scope" bash ::: \
    "$scope/awk" run_report_lane_for_parallel run_bats_lane "$scope" awk ::: \
    "$scope/applescript/bats" run_report_lane_for_parallel run_bats_lane "$scope" applescript ::: \
    "$scope/python/pytest" run_report_lane_for_parallel run_python_lane "$scope" ::: \
    "$scope/zsh" run_report_lane_for_parallel run_zsh_lane "$scope" ::: \
    "$scope/ruby" run_report_lane_for_parallel run_ruby_lane "$scope" ::: \
    "$scope/applescript/osacompile" run_report_lane_for_parallel run_applescript_lane "$scope" ::: \
    "$scope/nix" run_report_lane_for_parallel run_nix_lane "$scope" :::
}

report_parallel_enabled_for_scope() {
  local scope="$1"

  [ "$report" -eq 1 ] || return 1
  parallel_enabled || return 1

  case "$mode:$scope" in
    unit:unit|int:int|all:unit|all:int)
      return 0
      ;;
  esac

  return 1
}

run_language_lanes_for_scope() {
  local scope="$1"
  local status

  if [ "$report" -eq 0 ] && parallel_enabled; then
    run_language_lanes_parallel "$scope"
  elif report_parallel_enabled_for_scope "$scope"; then
    if run_report_language_lanes_parallel "$scope"; then
      :
    else
      status="$?"
      if [ "$suite_status" -eq 0 ]; then
        suite_status="$status"
      fi
    fi
  elif [ "$report" -eq 1 ]; then
    run_report_language_lanes_serial "$scope"
  else
    run_language_lanes "$scope"
  fi
}

run_nix_flake_check() {
  local command=(nix flake check "$flake_ref" --no-update-lock-file --no-write-lock-file)

  if [ "${#flake_options[@]}" -gt 0 ]; then
    command+=("${flake_options[@]}")
  fi

  if [ -n "$build_jobs" ]; then
    command+=(--max-jobs "$build_jobs")
  fi

  "${command[@]}"
}

run_darwin_system_build() {
  local command=(
    nix build --no-link --no-update-lock-file --no-write-lock-file
    "$flake_ref#darwinConfigurations.example-primary.system"
  )

  if [ "${#flake_options[@]}" -gt 0 ]; then
    command+=("${flake_options[@]}")
  fi

  if [ -n "$build_jobs" ]; then
    command+=(--max-jobs "$build_jobs")
  fi

  "${command[@]}"
}

case "$mode" in
  all)
    run_suite_step "patch hygiene" git --no-pager -C "$repo_dir" diff --check
    run_suite_step "flake check" run_nix_flake_check
    run_suite_step "shell syntax" run_shell_syntax_checks
    run_language_lanes_for_scope unit
    run_language_lanes_for_scope int
    ;;
  unit)
    run_suite_step "patch hygiene" git --no-pager -C "$repo_dir" diff --check
    run_suite_step "shell syntax" run_shell_syntax_checks
    run_language_lanes_for_scope unit
    ;;
  int)
    run_suite_step "flake check" run_nix_flake_check
    run_language_lanes_for_scope int
    ;;
  *)
    fail "unknown mode: $mode"
    ;;
esac

if [ "$full" -eq 1 ]; then
  case "$mode" in
    all|int)
      run_suite_step "Darwin system build" run_darwin_system_build
      ;;
    unit)
      fail "--full is only supported for all and int modes"
      ;;
  esac
fi

record_nix_source_target_coverage_for_mode
record_python_source_target_coverage_for_mode
record_ruby_source_target_coverage_for_mode
record_bash_source_target_coverage_for_mode
record_bats_statement_coverage_for_mode
record_zsh_statement_coverage_for_mode
record_bash_kcov_coverage_for_mode
merge_report_metric_files
report_summary_ready=1
if summarize_test_report; then
  :
else
  status="$?"
  report_summary_ready=0
  record_execution_failure "report summary generation" "$status"
  if [ "$suite_status" -eq 0 ]; then
    suite_status="$status"
  fi
fi
if [ "$report_summary_ready" -eq 1 ]; then
  if enforce_coverage_gates; then
    :
  else
    record_execution_failure "coverage gates" 1
    if [ "$suite_status" -eq 0 ]; then
      suite_status=1
    fi
  fi
fi
write_execution_status
if render_test_report; then
  :
else
  status="$?"
  record_execution_failure "report rendering" "$status"
  if [ "$suite_status" -eq 0 ]; then
    suite_status="$status"
  fi
  write_execution_status
fi
print_report_summary
if [ "$suite_status" -ne 0 ]; then
  printf '\nNix-darwin %s tests failed. See %s for details.\n' "$mode" "$report_dir" >&2
  exit "$suite_status"
fi

printf '\nAll nix-darwin %s tests passed.\n' "$mode"
