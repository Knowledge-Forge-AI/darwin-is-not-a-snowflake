#!/run/current-system/sw/bin/bash

managed_bash=/run/current-system/sw/bin/bash
if [ "${BASH:-}" != "$managed_bash" ]; then
  if [ ! -x "$managed_bash" ]; then
    echo "nix-darwin-test: managed Bash is unavailable: $managed_bash" >&2
    exit 127
  fi
  exec "$managed_bash" "$0" "$@"
fi

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
repo_dir="${NIX_DARWIN_TEST_ROOT:-$(cd "$script_dir/../.." && pwd -P)}"
test_source="${NIX_DARWIN_TEST_SOURCE:-git}"
case "$test_source" in
  git) flake_ref="$repo_dir" ;;
  worktree) flake_ref="path:$repo_dir" ;;
  *)
    echo "nix-darwin-test: NIX_DARWIN_TEST_SOURCE must be git or worktree" >&2
    exit 2
    ;;
esac
python_pycache_prefix="${PYTHONPYCACHEPREFIX:-$HOME/.cache/python/__pycache__}"
mode="all"
full=0
report=0
jobs="${NIX_DARWIN_TEST_JOBS:-1}"
if [ "${NIX_DARWIN_TEST_JOBS+x}" = x ]; then
  jobs="$NIX_DARWIN_TEST_JOBS"
fi
build_jobs="${NIX_DARWIN_BUILD_JOBS:-}"
flake_options=()
report_root="${NIX_DARWIN_TEST_REPORT_ROOT:-$repo_dir/.test-reports}"
report_dir=""
summary_file=""
summary_metric_dir=""
suite_status=0
kcov_bash_wrapper="$script_dir/kcov-bash-wrapper"
test_report_libexec="$repo_dir/libexec/test-report"
parallel_step_pids=()
parallel_step_labels=()
parallel_step_logs=()
parallel_step_log_dir=""
parallel_step_index=0
parallel_step_failed=0
current_report_lane_status=0
runner_dir=""
runner_steps_file=""
runner_failures_file=""
runner_execution_file=""
runner_step_index=0
runner_failure_sequence=0

usage() {
  cat <<USAGE
Usage: $(basename "$0") [all|unit|int] [--full] [--report] [-j N]

Run nix-darwin tests.

Modes:
  all      Run all language test lanes.
  unit     Run fast unit test lanes.
  int      Run integration test lanes.

Options:
  --full   Include the Darwin system build for all/int modes.
  --report Write detailed test and coverage reports under .test-reports.
  --report-root PATH
           Write report artifacts beneath this exact absolute root.
  -j, --jobs N
           Set the maximum test jobs. --jobs 1 is the sequential baseline.
  --flake-option VALUE
           Append one exact argument to source-owned Nix flake check/build commands.
  -h, --help
           Show this help.

Environment:
  NIX_DARWIN_TEST_JOBS
           Default jobs value when -j/--jobs is not provided.
  NIX_DARWIN_BUILD_JOBS
           Optional positive Nix build/check job count passed as --max-jobs.
  NIX_DARWIN_TEST_SOURCE
           Use git (default) for tracked-source purity or worktree for an
           unstaged dispatcher candidate.
USAGE
}

fail() {
  echo "nix-darwin-test: $*" >&2
  exit 1
}

validate_jobs() {
  if [ -z "$jobs" ]; then
    fail "jobs must be a positive integer: empty value"
  fi

  case "$jobs" in
    *[!0-9]*)
      fail "jobs must be a positive integer: $jobs"
      ;;
  esac

  if [ "$jobs" -le 0 ]; then
    fail "jobs must be a positive integer: $jobs"
  fi
}

validate_build_jobs() {
  [ -n "$build_jobs" ] || return 0

  case "$build_jobs" in
    *[!0-9]*)
      fail "NIX_DARWIN_BUILD_JOBS must be a positive integer: $build_jobs"
      ;;
  esac

  if [ "$build_jobs" -le 0 ]; then
    fail "NIX_DARWIN_BUILD_JOBS must be a positive integer: $build_jobs"
  fi
}

parallel_enabled() {
  [ "$jobs" -gt 1 ]
}

run_step() {
  local label="$1"
  local status

  shift
  printf '\n==> %s\n' "$label"
  if [ "$report" -eq 1 ]; then
    if "$@"; then
      return 0
    else
      status="$?"
    fi
    if [ "$suite_status" -eq 0 ]; then
      suite_status="$status"
    fi
    if [ "$current_report_lane_status" -eq 0 ]; then
      current_report_lane_status="$status"
    fi
    printf 'nix-darwin-test: %s failed with exit code %s\n' "$label" "$status" >&2
    return 0
  fi

  "$@"
}

runner_step_slug() {
  printf '%s' "$1" | tr '[:upper:] ' '[:lower:]-' | tr -cd 'a-z0-9-'
}

record_execution_failure() {
  local label="$1"
  local status="$2"

  [ "$report" -eq 1 ] || return 0
  runner_failure_sequence=$((runner_failure_sequence + 1))
  printf '%s\t%s\t%s\n' "$runner_failure_sequence" "$label" "$status" >> "$runner_failures_file"
}

write_execution_status() {
  local status="pass"
  local output_file

  [ "$report" -eq 1 ] || return 0
  if [ "$suite_status" -ne 0 ]; then
    status="fail"
  fi
  output_file="$runner_execution_file.tmp"
  printf 'status\texit_code\n%s\t%s\n' "$status" "$suite_status" > "$output_file"
  mv "$output_file" "$runner_execution_file"
}

run_suite_step() {
  local label="$1"
  local slug
  local step_dir
  local output_file
  local relative_output
  local command_status
  local capture_status
  local statuses=()
  local status

  shift
  if [ "$report" -eq 0 ]; then
    run_step "$label" "$@"
    return
  fi

  [ -n "$runner_steps_file" ] || fail "runner report artifacts were not initialized"
  runner_step_index=$((runner_step_index + 1))
  slug="$(runner_step_slug "$label")"
  step_dir="$runner_dir/$(printf '%03d' "$runner_step_index")-$slug"
  output_file="$step_dir/output.txt"
  relative_output="runner/$(basename "$step_dir")/output.txt"
  mkdir -p "$step_dir"

  printf '\n==> %s\n' "$label"
  set +e
  "$@" 2>&1 | tee "$output_file"
  statuses=("${PIPESTATUS[@]}")
  set -e
  command_status="${statuses[0]}"
  capture_status="${statuses[1]}"
  status="$command_status"
  if [ "$capture_status" -ne 0 ]; then
    printf 'nix-darwin-test: could not capture %s output (tee exit %s)\n' "$label" "$capture_status" >&2
    [ "$status" -ne 0 ] || status="$capture_status"
  fi

  if [ "$status" -eq 0 ]; then
    printf '%s\t%s\tpass\t0\t%s\n' "$runner_step_index" "$label" "$relative_output" >> "$runner_steps_file"
    return 0
  fi

  printf '%s\t%s\tfail\t%s\t%s\n' "$runner_step_index" "$label" "$status" "$relative_output" >> "$runner_steps_file"
  record_execution_failure "$label" "$status"
  if [ "$suite_status" -eq 0 ]; then
    suite_status="$status"
  fi
  printf 'nix-darwin-test: %s failed with exit code %s\n' "$label" "$status" >&2
  return 0
}

reset_parallel_batch() {
  parallel_step_pids=()
  parallel_step_labels=()
  parallel_step_logs=()
}

start_parallel_step() {
  local label="$1"
  local log_file

  shift
  parallel_step_index=$((parallel_step_index + 1))
  log_file="$parallel_step_log_dir/$(printf '%03d' "$parallel_step_index").log"
  printf '\n==> %s\n' "$label"
  ( "$@" ) > "$log_file" 2>&1 &
  parallel_step_pids+=("$!")
  parallel_step_labels+=("$label")
  parallel_step_logs+=("$log_file")
}

wait_parallel_batch() {
  local index
  local pid
  local label
  local log_file
  local status

  for index in "${!parallel_step_pids[@]}"; do
    pid="${parallel_step_pids[$index]}"
    label="${parallel_step_labels[$index]}"
    log_file="${parallel_step_logs[$index]}"

    if wait "$pid"; then
      cat "$log_file"
    else
      status="$?"
      if [ "$report" -eq 1 ]; then
        [ "$parallel_step_failed" -ne 0 ] || parallel_step_failed="$status"
        record_execution_failure "$label" "$status"
        if [ "$suite_status" -eq 0 ]; then
          suite_status="$status"
        fi
      else
        parallel_step_failed=1
      fi
      printf 'nix-darwin-test: %s failed with exit code %s\n' "$label" "$status" >&2
      printf 'nix-darwin-test: captured log for %s:\n' "$label" >&2
      cat "$log_file" >&2
    fi
  done

  reset_parallel_batch
}

run_parallel_steps() {
  local max_jobs="$1"
  local label
  local status
  local command=()

  shift
  if [ "$max_jobs" -le 1 ]; then
    while [ "$#" -gt 0 ]; do
      label="$1"
      shift
      command=()
      while [ "$#" -gt 0 ] && [ "$1" != ":::" ]; do
        command+=("$1")
        shift
      done
      [ "$#" -eq 0 ] || shift
      run_step "$label" "${command[@]}"
    done
    return 0
  fi

  parallel_step_log_dir="$(mktemp -d "${TMPDIR:-/tmp}/nix-darwin-test-parallel.XXXXXX")" \
    || fail "could not create parallel test log directory"
  parallel_step_index=0
  parallel_step_failed=0
  reset_parallel_batch

  while [ "$#" -gt 0 ]; do
    label="$1"
    shift
    command=()
    while [ "$#" -gt 0 ] && [ "$1" != ":::" ]; do
      command+=("$1")
      shift
    done
    [ "$#" -eq 0 ] || shift
    start_parallel_step "$label" "${command[@]}"
    if [ "${#parallel_step_pids[@]}" -ge "$max_jobs" ]; then
      wait_parallel_batch
    fi
  done

  if [ "${#parallel_step_pids[@]}" -gt 0 ]; then
    wait_parallel_batch
  fi

  status="$parallel_step_failed"
  rm -rf "$parallel_step_log_dir"
  parallel_step_log_dir=""
  return "$status"
}

run_report_command() {
  local output_file="$1"
  local status

  shift
  mkdir -p "$(dirname "$output_file")"
  set +e
  "$@" > "$output_file" 2>&1
  status="$?"
  set -e
  if [ "$status" -ne 0 ]; then
    printf 'nix-darwin-test: raw command output captured at %s\n' "$output_file" >&2
  fi
  return "$status"
}

prepare_report() {
  [ "$report" -eq 1 ] || return 0

  report_dir="$report_root/$mode/latest"
  rm -rf "$report_dir"
  mkdir -p "$report_dir"
  summary_file="$report_dir/summary.tsv"
  summary_metric_dir="$report_dir/summary.d"
  runner_dir="$report_dir/runner"
  runner_steps_file="$runner_dir/steps.tsv"
  runner_failures_file="$runner_dir/failures.tsv"
  runner_execution_file="$runner_dir/execution.tsv"
  runner_step_index=0
  runner_failure_sequence=0
  mkdir -p "$summary_metric_dir" "$runner_dir"
  printf 'scope\tlanguage\tmetric\tvalue\n' > "$summary_file"
  printf 'ordinal\tlabel\tstatus\texit_code\toutput_log\n' > "$runner_steps_file"
  printf 'sequence\tlabel\texit_code\n' > "$runner_failures_file"
}

report_language_dir() {
  local scope="$1"
  local language="$2"

  printf '%s/%s/%s' "$report_dir" "$scope" "$language"
}

scope_label() {
  case "$1" in
    int)
      printf 'integration'
      ;;
    *)
      printf '%s' "$1"
      ;;
  esac
}

record_report_metric() {
  local scope="$1"
  local language="$2"
  local metric="$3"
  local value="$4"

  [ "$report" -eq 1 ] || return 0
  printf '%s\t%s\t%s\t%s\n' "$scope" "$language" "$metric" "$value" >> "$summary_file"
}

report_metric_file() {
  local scope="$1"
  local language="$2"

  printf '%s/%s-%s.tsv' "$summary_metric_dir" "$scope" "$language"
}

record_report_metric_to_file() {
  local output_file="$1"
  local scope="$2"
  local language="$3"
  local metric="$4"
  local value="$5"

  [ "$report" -eq 1 ] || return 0
  mkdir -p "$(dirname "$output_file")"
  printf '%s\t%s\t%s\t%s\n' "$scope" "$language" "$metric" "$value" >> "$output_file"
}

merge_report_metric_files() {
  local metric_file

  [ "$report" -eq 1 ] || return 0
  [ -d "$summary_metric_dir" ] || return 0

  while IFS= read -r metric_file; do
    cat "$metric_file" >> "$summary_file"
  done < <(find "$summary_metric_dir" -type f -name '*.tsv' | sort)
}

run_report_python() {
  mkdir -p "$python_pycache_prefix"
  if command -v python3 >/dev/null 2>&1 &&
    env PYTHONPYCACHEPREFIX="$python_pycache_prefix" python3 -c 'import html, json, xml.etree.ElementTree' >/dev/null 2>&1; then
    env PYTHONPYCACHEPREFIX="$python_pycache_prefix" python3 "$@"
    return
  fi

  local system="${NIX_DARWIN_TEST_SYSTEM:-aarch64-darwin}"
  env PYTHONPYCACHEPREFIX="$python_pycache_prefix" \
    nix shell "$flake_ref#nixDarwinTestPython" -c python3 "$@"
}

render_test_report() {
  [ "$report" -eq 1 ] || return 0

  run_report_python "$script_dir/report/render.py" \
    --report-dir "$report_dir" \
    --summary-file "$summary_file" \
    --repo-root "$repo_dir" \
    --render-only
}

summarize_test_report() {
  [ "$report" -eq 1 ] || return 0

  run_report_python "$script_dir/report/render.py" \
    --report-dir "$report_dir" \
    --summary-file "$summary_file" \
    --repo-root "$repo_dir" \
    --summary-only
}

coverage_percent_from_xml() {
  local coverage_xml="$1"
  local rate_attribute="${2:-line-rate}"
  local coverage_rate

  coverage_rate="$(sed -n "s/.*$rate_attribute=\"\\([^\"]*\\)\".*/\\1/p" "$coverage_xml" | head -n 1)"
  [ -n "$coverage_rate" ] || return 1
  awk -v rate="$coverage_rate" 'BEGIN { printf "%g%%", rate * 100 }'
}

coverage_percent_from_json() {
  local coverage_json="$1"
  local covered_percent

  covered_percent="$(sed -n 's/.*"percent_covered":[[:space:]]*"\{0,1\}\([0-9.][0-9.]*\)"\{0,1\}.*/\1/p' "$coverage_json" | tail -n 1)"
  [ -n "$covered_percent" ] || return 1
  printf '%s%%' "$covered_percent"
}

ruby_coverage_percent() {
  local coverage_json="$1"
  local coverage_kind="${2:-line}"
  local covered_percent

  covered_percent="$(sed -n "s/.*\"$coverage_kind\":[[:space:]]*\\([0-9.][0-9.]*\\).*/\\1/p" "$coverage_json" | head -n 1)"
  if [ -z "$covered_percent" ] && [ "$coverage_kind" = "line" ]; then
    covered_percent="$(sed -n 's/.*"covered_percent":[[:space:]]*\([0-9.][0-9.]*\).*/\1/p' "$coverage_json" | head -n 1)"
  fi
  [ -n "$covered_percent" ] || return 1
  printf '%s%%' "$covered_percent"
}

line_count() {
  local file="$1"

  /usr/bin/awk -f "$test_report_libexec/line-count.awk" "$file"
}

format_coverage_ratio() {
  local covered="$1"
  local total="$2"

  /usr/bin/awk -v covered="$covered" -v total="$total" \
    -f "$test_report_libexec/format-coverage-ratio.awk"
}

discover_nix_source_targets() {
  find "$repo_dir" \
    \( -path "$repo_dir/.git" -o -path "$repo_dir/.test-reports" -o -path "$repo_dir/src/test" \) -prune \
    -o -type f -name '*.nix' -print |
    /usr/bin/awk -v prefix="$repo_dir/" -f "$test_report_libexec/relative-paths.awk" |
    sort -u
}

is_bash_source_file() {
  local file="$1"
  local first_line

  case "$file" in
    "$repo_dir"/src/test/*|"$repo_dir"/tools/test/*|"$repo_dir"/.test-reports/*)
      return 1
      ;;
    "$repo_dir"/bin/nix-test|"$repo_dir"/bin/nix-unit-test|"$repo_dir"/bin/nix-int-test|"$repo_dir"/scripts/test-all.sh)
      return 1
      ;;
    "$repo_dir"/shell/sh_config/zsh/*|"$repo_dir"/shell/oh-my-zsh-custom/*|"$repo_dir"/shell/zshrc)
      return 1
      ;;
  esac

  first_line="$(sed -n '1p' "$file" 2>/dev/null || true)"
  case "$first_line" in
    *bash*)
      return 0
      ;;
  esac

  case "$file" in
    "$repo_dir"/scripts/*.sh|\
    "$repo_dir"/libexec/*/*.sh|\
    "$repo_dir"/tools/bootstrap/*.sh|\
    "$repo_dir"/shell/bash_profile|\
    "$repo_dir"/shell/bashrc|\
    "$repo_dir"/shell/sh_config/bash/*|\
    "$repo_dir"/shell/sh_config/common/*)
      return 0
      ;;
  esac

  return 1
}

discover_bash_source_files() {
  {
    [ -d "$repo_dir/bin" ] && find "$repo_dir/bin" -maxdepth 1 -type f
    [ -d "$repo_dir/scripts" ] && find "$repo_dir/scripts" -maxdepth 1 -type f
    [ -d "$repo_dir/libexec" ] && find "$repo_dir/libexec" -mindepth 2 -maxdepth 2 -type f -name '*.sh'
    [ -d "$repo_dir/tools/bootstrap" ] && find "$repo_dir/tools/bootstrap" -maxdepth 1 -type f -name '*.sh'
    [ -f "$repo_dir/shell/bash_profile" ] && printf '%s\n' "$repo_dir/shell/bash_profile"
    [ -f "$repo_dir/shell/bashrc" ] && printf '%s\n' "$repo_dir/shell/bashrc"
    [ -d "$repo_dir/shell/sh_config/bash" ] && find "$repo_dir/shell/sh_config/bash" -maxdepth 1 -type f
    [ -d "$repo_dir/shell/sh_config/common" ] && find "$repo_dir/shell/sh_config/common" -maxdepth 1 -type f
  } |
    while IFS= read -r file; do
      if is_bash_source_file "$file"; then
        printf '%s\n' "$file"
      fi
    done |
    sort -u
}

join_lines_by_comma() {
  /usr/bin/awk -f "$test_report_libexec/join-lines-by-comma.awk"
}

parent_dirs_from_files() {
  sed 's#/[^/]*$##' | sort -u
}

bats_language_extension() {
  case "$1" in
    awk)
      printf 'awk'
      ;;
    applescript)
      printf 'applescript'
      ;;
    *)
      return 1
      ;;
  esac
}

discover_bats_language_source_targets() {
  local language="$1"
  local extension

  extension="$(bats_language_extension "$language")" || return 1
  [ -d "$repo_dir/libexec" ] || return 0
  find "$repo_dir/libexec" -type f -name "*.$extension" -print |
    /usr/bin/awk -v prefix="$repo_dir/" -f "$test_report_libexec/relative-paths.awk" |
    sort -u
}

bats_language_has_tests() {
  local language="$1"
  local scope
  local test_dir

  shift
  for scope in "$@"; do
    test_dir="$repo_dir/src/test/$scope/$language"
    [ -d "$test_dir" ] || continue
    if find "$test_dir" -type f -name '*.bats' -print -quit | grep -q .; then
      return 0
    fi
  done

  return 1
}

declared_bats_language_source_targets() {
  local language="$1"
  local extension
  local scope
  local test_dir
  local test_file

  shift
  extension="$(bats_language_extension "$language")" || return 1

  for scope in "$@"; do
    test_dir="$repo_dir/src/test/$scope/$language"
    [ -d "$test_dir" ] || continue
    while IFS= read -r test_file; do
      sed -n "s#.*\\\$repo_dir/\\([^\"'[:space:]]*\\.$extension\\).*#\\1#p" "$test_file"
    done < <(find "$test_dir" -type f -name '*.bats' | sort)
  done |
    sed 's/[[:space:]]*$//' |
    /usr/bin/awk -f "$test_report_libexec/nonblank-lines.awk" |
    sort -u
}

statement_line_count() {
  local language="$1"
  local file="$2"

  /usr/bin/awk -v language="$language" -f "$test_report_libexec/statement-line-count.awk" "$file"
}

declared_nix_source_targets() {
  local scope
  local test_dir
  local test_file

  for scope in "$@"; do
    test_dir="$repo_dir/src/test/$scope/nix"
    [ -d "$test_dir" ] || continue
    while IFS= read -r test_file; do
      /usr/bin/awk -f "$test_report_libexec/header-source-targets.awk" "$test_file"
    done < <(find "$test_dir" -type f -name '*.nix' | sort)
  done |
    sed 's/[[:space:]]*$//' |
    /usr/bin/awk -f "$test_report_libexec/nonblank-lines.awk" |
    sort -u
}

