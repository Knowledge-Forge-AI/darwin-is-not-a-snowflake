#Python

# ==========================================
# Byte-compiled / optimized / DLL files
# ==========================================
__pycache__/
*.py[cod]
*$py.class

# ==========================================
# Virtual Environments
# ==========================================
.venv/
venv/
ENV/
env/
# Pipenv and Poetry lock files are tracked, but local caches are not
.venv
.poetry/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*

# ==========================================
# Distribution / Packaging
# ==========================================
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
# The Python packaging rules above are repository-wide, so they also swallow
# real Nix source directories. lib holds core's reusable Nix
# contract and is tracked source, not a build artifact.
!/lib/
!/lib/**
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ==========================================
# Secrets and Environment Variables
# ==========================================
.env
*.env
*.secret

# ==========================================
# IDE and Code Editor Settings
# ==========================================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Private operator scratch is never publication source.
.scratch/
