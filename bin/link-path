#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf '%s\n' 'Usage: link-path [-l] TARGET LINK'
}

require_path() {
  local path="$1"

  if [[ ! -e "$path" ]]; then
    printf 'link-path: target does not exist: %s\n' "$path" >&2
    return 1
  fi
}

link_is_locked() {
  [[ "$(/usr/bin/stat -f '%Sf' "$1")" == *uchg* ]]
}

link_path() {
  local lock_link="$1"
  local target="$2"
  local link="$3"
  local backup

  require_path "$target"
  mkdir -p "$(dirname "$link")"

  if [[ -L "$link" ]]; then
    if [[ "$(readlink "$link")" == "$target" ]]; then
      if [[ "$lock_link" == "true" ]] && ! link_is_locked "$link"; then
        /usr/bin/chflags -h uchg "$link"
      fi
      return 0
    fi

    if link_is_locked "$link"; then
      /usr/bin/chflags -h nouchg "$link"
    fi
    rm "$link"
  elif [[ -e "$link" ]]; then
    backup="$link.before-link-path.$(/bin/date +%Y%m%d%H%M%S)"
    mv "$link" "$backup"
  fi

  ln -s "$target" "$link"

  if [[ "$lock_link" == "true" ]]; then
    /usr/bin/chflags -h uchg "$link"
  fi
}

main() {
  local lock_link="false"

  if [[ $# -gt 0 && "$1" == "-l" ]]; then
    lock_link="true"
    shift
  fi

  if [[ $# -eq 1 && "$1" == "--help" ]]; then
    usage
    return 0
  fi

  if [[ $# -ne 2 ]]; then
    usage >&2
    return 2
  fi

  link_path "$lock_link" "$1" "$2"
}

main "$@"
