_nix_darwin_env_snapshot() {
  local _nix_darwin_snapshot_shell
  _nix_darwin_snapshot_shell=

  if [ -n "${ZSH_VERSION:-}" ]; then
    _nix_darwin_snapshot_shell=zsh
  elif [ -n "${BASH_VERSION:-}" ]; then
    _nix_darwin_snapshot_shell=bash
  fi

  [ -n "$_nix_darwin_snapshot_shell" ] || return 0
  command -v env-snapshot >/dev/null 2>&1 || return 0
  env-snapshot --mode sync --shell "$_nix_darwin_snapshot_shell" --context global >/dev/null 2>&1 || true
}

_nix_darwin_env_snapshot_install_prompt_hook() {
  if [ -n "${ZSH_VERSION:-}" ]; then
    autoload -Uz add-zsh-hook 2>/dev/null || true
    add-zsh-hook -d precmd _nix_darwin_env_snapshot >/dev/null 2>&1 || true
    add-zsh-hook precmd _nix_darwin_env_snapshot >/dev/null 2>&1 || true
  elif [ -n "${BASH_VERSION:-}" ]; then
    case ";${PROMPT_COMMAND:-};" in
      *";_nix_darwin_env_snapshot;"*)
        ;;
      *)
        if [ -n "${PROMPT_COMMAND:-}" ]; then
          PROMPT_COMMAND="_nix_darwin_env_snapshot; ${PROMPT_COMMAND:-}"
        else
          PROMPT_COMMAND="_nix_darwin_env_snapshot"
        fi
        ;;
    esac
  fi

  _nix_darwin_env_snapshot
}
