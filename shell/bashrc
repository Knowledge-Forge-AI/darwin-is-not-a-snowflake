for file in "$HOME"/.sh_config/common/*; do
  [ -f "$file" ] || continue
  [ "$(basename "$file")" = "999_on-login" ] && continue
  source "$file"
done

for file in "$HOME"/.sh_config/bash/*; do
  [ -f "$file" ] || continue
  source "$file"
done

if [ -f "$HOME/.sh_config/common/999_on-login" ]; then
  source "$HOME/.sh_config/common/999_on-login"
fi
